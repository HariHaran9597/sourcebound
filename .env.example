# Local development credentials only. Use a secret manager in deployed environments.
POSTGRES_DB=sourcebound
POSTGRES_USER=sourcebound
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_HOST_PORT=5433
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
RABBITMQ_USER=sourcebound
RABBITMQ_PASSWORD=change-this-local-password
API_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
# Tune to the host's memory and CPU budget; worker processes PDF uploads.
WORKER_MEMORY_LIMIT=6g
WORKER_CPUS=2.0
SOURCEBOUND_LLM_BASE_URL=http://host.docker.internal:11434/v1
SOURCEBOUND_LLM_API_KEY=ollama
SOURCEBOUND_LLM_MODEL=qwen3.5:2b
SOURCEBOUND_RERANKER_ENABLED=true
SOURCEBOUND_RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
SOURCEBOUND_RETRIEVAL_CANDIDATE_LIMIT=32
SOURCEBOUND_AUTH_MODE=disabled
# For OIDC mode, set issuer and API audience and map organization_id into the access token.
SOURCEBOUND_OIDC_ISSUER=
SOURCEBOUND_OIDC_AUDIENCE=
SOURCEBOUND_OIDC_CLIENT_ID=
SOURCEBOUND_METRICS_ENABLED=true
# OpenTelemetry trace export is opt-in. Compose's Jaeger backend is in the `observability` profile.
SOURCEBOUND_TRACING_ENABLED=false
SOURCEBOUND_OTEL_SERVICE_NAME=sourcebound-api
SOURCEBOUND_TRACE_SAMPLE_RATIO=1.0
JAEGER_UI_PORT=16686
JAEGER_OTLP_HTTP_PORT=4318
SOURCEBOUND_ASK_RATE_LIMIT_PER_MINUTE=20
SOURCEBOUND_UPLOAD_RATE_LIMIT_PER_MINUTE=6
SOURCEBOUND_REPROCESS_RATE_LIMIT_PER_MINUTE=10
# Cross-user organization ceilings; tune to model and worker capacity.
SOURCEBOUND_ORGANIZATION_ASK_RATE_LIMIT_PER_MINUTE=500
SOURCEBOUND_ORGANIZATION_UPLOAD_RATE_LIMIT_PER_MINUTE=60
SOURCEBOUND_ORGANIZATION_REPROCESS_RATE_LIMIT_PER_MINUTE=100
# Per-organization stored-source quotas (all immutable PDF versions count toward storage).
SOURCEBOUND_ORGANIZATION_MAX_DOCUMENTS=1000
SOURCEBOUND_ORGANIZATION_MAX_STORAGE_BYTES=10737418240
# Per-API-process concurrency ceilings; also configure ingress limits when scaled out.
SOURCEBOUND_API_MAX_IN_FLIGHT=200
SOURCEBOUND_ASK_MAX_IN_FLIGHT=8
SOURCEBOUND_INGESTION_MAX_IN_FLIGHT=2
SOURCEBOUND_CAPACITY_WAIT_SECONDS=1.0
# Replace with `python -c "import secrets; print(secrets.token_hex(32))"`; share across API replicas.
SOURCEBOUND_RATE_LIMIT_HMAC_KEY=local-development-only-change-this-key
SOURCEBOUND_STORE_ANSWER_TRACES=true
SOURCEBOUND_ANSWER_TRACE_RETENTION_DAYS=30
